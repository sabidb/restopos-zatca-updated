rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// RestoPOS Firestore security rules — SINGLE SOURCE OF TRUTH for the
// restopos-db project. Deploy with:  firebase deploy --only firestore:rules
//
// ⚠️  TEST BEFORE PRODUCTION. These rules tighten a previously permissive
//     database. Run the Firebase emulator and exercise activation, credential
//     set, login, invoicing, cloud sync and the admin panel against them before
//     deploying to the live project — a wrong rule can lock out live tills.
//
// Model:
//   - Cloud Functions and the ZATCA microservice use the Admin SDK, which
//     BYPASSES these rules. So credential hashing (setClientCredentials),
//     login (verifyLogin), manager analytics (getManagerData) and ZATCA signing
//     are unaffected by anything here.
//   - Secrets (config, zatca_egs, orgs, manager_logins) are readable/writable
//     ONLY through the Admin SDK — never from any client.
//   - A device "owns" a license when its UID is in the license's authUids.
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    // Single owner admin (admin panel signs in as this Firebase Auth account).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.get('email', '') == '8742sabithsaleem@gmail.com'
        && request.auth.token.get('email_verified', false) == true;
    }
    // A caller "owns" a license when either (a) it is signed in with the
    // custom token minted by verifyLogin (uid == the license key / doc id), or
    // (b) its anonymous device UID is on the license's authUids allowlist.
    function ownsLicenseKey(licenseKey) {
      return isSignedIn() && (
        request.auth.uid == licenseKey
        || (exists(/databases/$(database)/documents/pending_activations/$(licenseKey))
            && request.auth.uid in get(/databases/$(database)/documents/pending_activations/$(licenseKey)).data.authUids)
      );
    }
    // Fields on pending_activations that only the Admin SDK / admin panel may
    // change. A client update that leaves all of these untouched is allowed.
    function noPrivilegedChange() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'credentialsApproved', 'isActive', 'status', 'passwordHash',
        'clientUsername', 'subscriptionPlan', 'customExpiryDate',
        // Brute-force lockout counters — only the Admin SDK (verifyLogin) writes these.
        'loginFailCount', 'loginLockUntil',
        // Terms acceptance is a legal record: the client writes it once, at
        // registration, and can never edit it afterwards. An acceptance its own
        // signer could backdate or withdraw would be worthless as evidence.
        // The admin panel can still correct it — isAdmin bypasses this check.
        'termsAccepted', 'termsAcceptedAt', 'termsVersion', 'termsAcceptance'
      ]);
    }

    // ── Why `list` is admin-only nearly everywhere below ───────────────────
    // The app signs devices in with signInAnonymously, and the Firebase config
    // ships in the client bundle. So `isSignedIn()` does NOT mean "a customer
    // of ours" — anyone who opens the site can obtain that token. It is a
    // rate-limiting identity, not an authorisation.
    //
    // That distinction decides everything here. `get` on a doc keyed by a
    // license key still needs a signed-in caller only, because a device must
    // read its own account before it is on the authUids allowlist (a second
    // terminal polling for approval). But `list` is what turns a guessed key
    // into a full export of every tenant, so listing is reserved for the
    // admin panel, which signs in with a real password as the owner account.
    //
    // Rules cannot filter a query, so a collection read is all-or-nothing:
    // if a client ever needs to list one of these, it must go through a
    // Cloud Function on the Admin SDK, not a widened rule.

    // Fields a device legitimately stamps on its own license during activation.
    // `active` is deliberately absent: switching a license off is the
    // kill-switch, and a client must never be able to switch its own back on.
    function onlyLicenseStamp() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'activatedBy', 'activatedAt', 'businessName', 'vatNumber', 'email',
        'phone', 'city', 'deviceId', 'deviceInfo', 'location', 'locationUpdatedAt',
        'updatedAt'
      ]);
    }

    // A ZATCA invoice is a tax record in a hash chain: each one commits to the
    // previous invoice's hash, so altering an archived invoice breaks the chain
    // and the audit trail with it. Re-archiving the same invoice is fine (the
    // values are identical, so they don't count as changed) and clearance
    // updates may add fields — but these may never be rewritten.
    function zatcaChainIntact() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'invoice_number', 'uuid', 'seller_vat', 'invoice_hash',
        'prev_invoice_hash', 'icv', 'total', 'vat_amount', 'timestamp'
      ]);
    }

    // ── HARD-LOCKED SECRETS ────────────────────────────────────────────────
    // Anthropic API key, ZATCA EGS private keys/certs, manager PIN hashes and
    // the branch→client linking. Only reachable via the Admin SDK.
    //
    // config/announcement is the ONE exception: it carries the plain-text system
    // broadcast the admin panel pushes to every terminal (no secret). Without this
    // carve-out the admin's broadcast write AND the client's live banner listener
    // both hit the `if false` below and silently fail. A request is allowed if ANY
    // matching rule grants it, so this specific match wins over config/{doc}.
    match /config/announcement     { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /config/{doc}            { allow read, write: if false; }
    match /zatca_egs/{licenseKey}  { allow read, write: if false; }
    match /manager_logins/{key}    { allow read, write: if isAdmin(); }
    match /orgs/{orgId}            { allow read, write: if false; }
    match /activity_log/{doc}      { allow read, write: if isAdmin(); }
    // Password-reset OTP hashes — written/verified only by the Admin SDK.
    match /password_resets/{key}   { allow read, write: if false; }

    // ── pending_activations ────────────────────────────────────────────────
    // Self-serve 14-day trials live here too, keyed TRIAL-<10-digit mobile>
    // and flagged isTrial + trialSource:"self-serve". They are created by the
    // client under exactly the same restriction as any activation — status
    // "pending", credentialsApproved false — so no rule change was needed for
    // them; the admin panel's Trials tab picks them out by the flag, and
    // customExpiryDate (client-set at creation, admin-editable afterwards)
    // is what the kill-switch watchdog enforces as the trial end date.
    // The core license/account doc. Credential fields (passwordHash,
    // clientUsername, credentialsApproved) and lifecycle fields (isActive,
    // status) are set only by the Admin SDK / admin panel. A device may edit a
    // narrow set of its own device-management fields.
    // A single doc is readable by any signed-in device: a new/unapproved device
    // must read it to poll for approval, and the logged-in client (uid == key)
    // and the kill-switch watchdog read it live — all by known key.
    //
    // Listing the collection is admin-only. These docs carry the client's CR
    // and VAT numbers, address, email, phone, bcrypt password hash and now the
    // terms-acceptance record including the signer's name and IP address. A
    // readable list is a one-request export of every client on the platform.
    match /pending_activations/{key} {
      allow get: if isSignedIn();
      allow list: if isAdmin();

      // Activation creates the doc — a client can never create it pre-approved.
      allow create: if isAdmin() || (
        isSignedIn()
        && request.resource.data.get('credentialsApproved', false) == false
        && request.resource.data.get('status', 'pending') == 'pending'
      );

      // A signed-in device may update device-management state (authUids,
      // pendingDevices, forceLogout, deviceInfo, …) but can NEVER flip approval,
      // active/status, subscription or the credential fields — those are set
      // only by the admin panel or the setClientCredentials Cloud Function.
      allow update: if isAdmin() || (isSignedIn() && noPrivilegedChange());

      allow delete: if isAdmin();
    }

    // ── licenses (issued by admin; activation stamps activatedBy/at) ────────
    match /licenses/{key} {
      // Activation checks one key it was given; only the admin panel lists the
      // catalogue of issued keys.
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      // Activation stamps its own metadata onto the key it just used. It may
      // not touch `active` — that is the kill switch.
      allow update: if isAdmin() || (isSignedIn() && onlyLicenseStamp());
    }

    // ── lookup indexes (written at activation; read during login/reset) ─────
    // These map an identifier to a license key, and the password-reset path
    // follows them. Pointing an index entry at a license you do NOT own is the
    // takeover: aim your own email at a victim's key, reset "your" password,
    // and you are inside their account.
    //
    // So the test is ownership of the target, not immutability of the mapping.
    // Freezing the mapping outright would also have broken a legitimate case —
    // a client re-registering the same email or VAT against a newly purchased
    // license key, which happens whenever a lapsed account comes back. Both
    // writers (activation and registerDeviceUid) create the account document
    // before touching the index, so by this point they genuinely own the key.
    function indexPointsToOwnLicense() {
      return ownsLicenseKey(request.resource.data.get('licenseKey', ''));
    }
    match /vat_index/{vat} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isAdmin() || (isSignedIn() && indexPointsToOwnLicense());
      allow update: if isAdmin() || (isSignedIn() && indexPointsToOwnLicense());
      allow delete: if isAdmin();
    }
    match /email_index/{email} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isAdmin() || (isSignedIn() && indexPointsToOwnLicense());
      allow update: if isAdmin() || (isSignedIn() && indexPointsToOwnLicense());
      allow delete: if isAdmin();
    }

    // ── ZATCA invoice archive (keyed by invoice number) ────────────────────
    // No per-owner field is guaranteed on these docs, so gate on auth. They
    // contain no secrets (signatures/hashes are public artifacts on receipts).
    //
    // `list` has to stay open to a signed-in till: restoring the hash chain
    // queries this collection by seller_vat, and rules cannot inspect a query's
    // where-clauses, so there is no way to express "only your own VAT" here.
    // The write side is where the value is, and it is locked: an archived
    // invoice's chain fields can never be rewritten by a client.
    match /zatca_invoices/{invoiceNumber} {
      allow read, create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && zatcaChainIntact());
      allow delete: if isAdmin();
    }

    // ── trials (readable mirror of a self-serve trial's activity) ──────────
    // client_data holds each localStorage key as one long JSON string: perfect
    // for restoring a device, unreadable in the console. `trials` carries the
    // same information as real documents — a usage summary on the parent, then
    // sales / products / customers as subcollections — so a trial can actually
    // be browsed and queried.
    //
    // Doc id is the trial key (TRIAL-<10-digit mobile>), which is also the
    // pending_activations id, so ownership is the same check as everywhere
    // else: the device UID must be on that account's authUids.
    match /trials/{trialKey} {
      allow read, write: if isAdmin() || ownsLicenseKey(trialKey);
      match /{document=**} {
        allow read, write: if isAdmin() || ownsLicenseKey(trialKey);
      }
    }

    // ── client_data (sales rollups; manager function reads via Admin SDK) ───
    // Doc id is the license key, so we can gate on license ownership directly.
    match /client_data/{licenseKey} {
      allow read, write: if isAdmin() || ownsLicenseKey(licenseKey);
    }

    // ── live support chat (room id = chat_<licenseKey>) ────────────────────
    // A support conversation is a private channel between one client and the
    // owner — clients describe problems, paste figures and attach photos of
    // their own tills. The room id embeds the license key, so ownership is the
    // same authUids check used everywhere else, applied to the key in the id.
    function ownsRoom(room) {
      return room.split('chat_').size() > 1 && ownsLicenseKey(room.split('chat_')[1]);
    }
    match /live_chats/{room} {
      allow read, write: if isAdmin() || ownsRoom(room);
      match /messages/{msg} {
        allow read, write: if isAdmin() || ownsRoom(room);
      }
    }

    // ── support tickets (clients create; admin triages) ────────────────────
    match /support_tickets/{ticket} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // Default: deny everything not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
