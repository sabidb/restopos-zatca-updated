# Firebase web config — NOT secret (it identifies the project; real protection is
# Firestore rules + Cloud Functions). Copy to .env and fill in from the Firebase
# console → Project settings → Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=restopos-db.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=restopos-db
VITE_FIREBASE_STORAGE_BUCKET=restopos-db.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Backend URL ──────────────────────────────────────────────────────
# The unified REST backend (auth, ZATCA, archive, AI, printing). Defaults to
# the Cloud Run production service if omitted.
#   VITE_BACKEND_URL=http://localhost:8080   # for local development
VITE_BACKEND_URL=https://zatca-service-82816670819.me-central1.run.app

# ── Free trial ───────────────────────────────────────────────────────
# Optional. The "Start a free 14-day trial" button on the registration screen
# works on any build without these — set them only if you want a SEPARATE
# deployment that is permanently a trial (e.g. try.restopos.store), which never
# shows the registration form.
#   VITE_TRIAL_MODE=true
#   VITE_TRIAL_EXIT_URL=https://restopos.store  # where "Register →" sends visitors

# Server-side SECRETS live in Firestore (config/secrets document) — NOT here.
# The backend reads them with the Admin SDK; see restopos-zatca-service README.
